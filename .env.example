# Optional backend Copilot rendering; feature_flags.copilot_llm is OFF by default.
# Keep real values only in the ignored .env file. These values are never sent to the browser.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# FULL, SIMPLIFIED, or FALLBACK. Prompt 1 does not calculate exposure yet.
HEATSHIELD_COMPUTATION_MODE=FULL
